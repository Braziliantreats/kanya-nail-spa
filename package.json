{
  "name": "crystal-rush",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Crystal Rush — a compliance-first, dispensary-brandable HTML5 endless runner (Three.js + TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
